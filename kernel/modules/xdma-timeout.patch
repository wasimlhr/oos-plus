--- a/xdma/libxdma.c
+++ b/xdma/libxdma.c
@@ -3638,8 +3638,8 @@
 			break;
 		default:
 			/* transfer can still be in-flight */
-			pr_info("xfer 0x%p,%u, s 0x%x timed out, ep 0x%llx.\n",
-				xfer, xfer->len, xfer->state, req->ep_addr);
+			pr_info_ratelimited("xfer 0x%p,%u, s 0x%x timed out, ep 0x%llx, %zd bytes before.\n",
+				xfer, xfer->len, xfer->state, req->ep_addr, done);
 			rv = engine_status_read(engine, 0, 1);
 			if (rv < 0) {
 				pr_err("Failed to read engine status\n");
@@ -3692,6 +3692,12 @@
 	if (req)
 		xdma_request_free(req);
 
+	/* a C2H stream that timed out is an error whatever arrived before: a
+	 * short count would make the reader ask again for the rest of a play
+	 * the FPGA will not finish, and the stream would lose its place (OOS)
+	 */
+	if (rv == -ETIMEDOUT && !write && engine && engine->streaming)
+		return rv;
 	/* as long as some data is processed, return the count */
 	return done ? done : rv;
 }
