# busybox.config - the configuration of the image's busybox (ADR 0078): rootfs/build-busybox.sh takes busybox's
# defconfig and sets each option below, then `make oldconfig` settles the options that depend on them. The build
# stops when a line did not take (a typo, an option of another version, one that its dependencies overrule). The
# applets that follow are listed in rootfs/busybox.applets.
#
# Up to 0.1.15 the image took Ubuntu's busybox-static 1.37.0. This configuration keeps its choices, apart from the
# first two groups below: the applets those take out, and the C library (musl instead of glibc, static as before).
# The lines are the options where defconfig differs from that configuration; built either way, the binary is the
# same file (2026-11-24).

# Network servers and the telnet client are not in the image: SSH is the only shell on the network (ADR 0054), and
# the other servers nothing starts. Off in Ubuntu's package already: ftpd, tftpd, inetd, dnsd, tcpsvd, udpsvd,
# fakeidentd, ntpd, dhcprelay, lpd and nc's listen mode of version 1.10. udhcpd stays: it answers only on the
# interfaces it is started for (USB gadget network, issue 235).
CONFIG_TELNETD=n
CONFIG_TELNET=n
CONFIG_HTTPD=n
CONFIG_FTPD=n
CONFIG_TFTPD=n
CONFIG_INETD=n
CONFIG_DNSD=n
CONFIG_TCPSVD=n
CONFIG_UDPSVD=n
CONFIG_FAKEIDENTD=n
CONFIG_NTPD=n
CONFIG_DHCPRELAY=n
CONFIG_LPD=n
CONFIG_NC_SERVER=n
CONFIG_NC_110_COMPAT=n

# Off because they do not build here: the SHA hardware acceleration is for x86 only and lacks a guard for arm64, and
# tc needs the CBQ definitions that newer kernel headers no longer have (no script calls tc). Ubuntu's EXTRA_COMPAT
# and FEATURE_VI_REGEX_SEARCH stay off as in defconfig: they need glibc's regular expressions.
CONFIG_SHA1_HWACCEL=n
CONFIG_SHA256_HWACCEL=n
CONFIG_TC=n

# The applets as in Ubuntu's package, where defconfig differs.
CONFIG_ADDGROUP=n
CONFIG_ADDUSER=n
CONFIG_ADD_SHELL=n
CONFIG_AR=y
CONFIG_BASE32=n
CONFIG_BEEP=n
CONFIG_BLKID=n
CONFIG_BOOTCHARTD=n
CONFIG_CHAT=n
CONFIG_CHPST=n
CONFIG_CHRT=n
CONFIG_CKSUM=n
CONFIG_COMM=n
CONFIG_CONSPY=n
CONFIG_CRYPTPW=n
CONFIG_DELGROUP=n
CONFIG_DELUSER=n
CONFIG_EJECT=n
CONFIG_ENVDIR=n
CONFIG_ENVUIDGID=n
CONFIG_ETHER_WAKE=n
CONFIG_FBSET=n
CONFIG_FBSPLASH=n
CONFIG_FDFLUSH=n
CONFIG_FDFORMAT=n
CONFIG_FGCONSOLE=n
CONFIG_FLOCK=n
CONFIG_FSCK=n
CONFIG_FSCK_MINIX=n
CONFIG_FSYNC=n
CONFIG_FUSER=n
CONFIG_HD=n
CONFIG_HDPARM=n
CONFIG_HEXEDIT=n
CONFIG_HUSH=n
CONFIG_IFENSLAVE=n
CONFIG_IFPLUGD=n
CONFIG_IOSTAT=n
CONFIG_IPADDR=n
CONFIG_IPCRM=n
CONFIG_IPCS=n
CONFIG_IPLINK=n
CONFIG_IPNEIGH=n
CONFIG_IPROUTE=n
CONFIG_IPRULE=n
CONFIG_IPTUNNEL=n
CONFIG_KBD_MODE=n
CONFIG_KILLALL5=n
CONFIG_LPQ=n
CONFIG_LPR=n
CONFIG_LSOF=n
CONFIG_LSPCI=n
CONFIG_LSUSB=n
CONFIG_MAKEDEVS=n
CONFIG_MAKEMIME=n
CONFIG_MAN=n
CONFIG_MESG=n
CONFIG_MKFS_EXT2=n
CONFIG_MKFS_MINIX=n
CONFIG_MKFS_VFAT=n
CONFIG_MOUNTPOINT=n
CONFIG_MPSTAT=n
CONFIG_NANDDUMP=n
CONFIG_NANDWRITE=n
CONFIG_NICE=n
CONFIG_NMETER=n
CONFIG_NOHUP=n
CONFIG_NUKE=y
CONFIG_PGREP=n
CONFIG_PIPE_PROGRESS=n
CONFIG_PKILL=n
CONFIG_PMAP=n
CONFIG_POPMAILDIR=n
CONFIG_POWERTOP=n
CONFIG_PRINTENV=n
CONFIG_PSCAN=n
CONFIG_PSTREE=n
CONFIG_PWDX=n
CONFIG_RAIDAUTORUN=n
CONFIG_RDEV=n
CONFIG_READAHEAD=n
CONFIG_READPROFILE=n
CONFIG_REFORMIME=n
CONFIG_REMOVE_SHELL=n
CONFIG_RESIZE=n
CONFIG_RTCWAKE=n
CONFIG_RUNLEVEL=n
CONFIG_RUNSV=n
CONFIG_RUNSVDIR=n
CONFIG_RX=n
CONFIG_SCRIPT=n
CONFIG_SCRIPTREPLAY=n
CONFIG_SEEDRNG=n
CONFIG_SENDMAIL=n
CONFIG_SETARCH=n
CONFIG_SETCONSOLE=n
CONFIG_SETFATTR=n
CONFIG_SETFONT=n
CONFIG_SETLOGCONS=n
CONFIG_SETSERIAL=n
CONFIG_SETUIDGID=n
CONFIG_SHOWKEY=n
CONFIG_SLATTACH=n
