CONFIG_ZCIP=n

# The other options as in Ubuntu's package, where defconfig differs. Among them: the shell runs its applets before
# PATH (FEATURE_PREFER_APPLETS, FEATURE_SH_STANDALONE), modprobe is the full one with modules.dep and aliases
# (MODPROBE_SMALL off), and the binary is static.
CONFIG_ASH_IDLE_TIMEOUT=n
CONFIG_FEATURE_AIX_LABEL=y
CONFIG_FEATURE_AR_LONG_FILENAMES=y
CONFIG_FEATURE_AWK_LIBM=n
CONFIG_FEATURE_BRCTL_FANCY=n
CONFIG_FEATURE_CHECK_TAINTED_MODULE=y
CONFIG_FEATURE_CHECK_UNICODE_IN_ENV=y
CONFIG_FEATURE_COPYBUF_KB=64
CONFIG_FEATURE_CPIO_P=n
CONFIG_FEATURE_CROND_D=n
CONFIG_FEATURE_DD_THIRD_STATUS_LINE=n
CONFIG_FEATURE_DEFAULT_PASSWD_ALGO="sha256"
CONFIG_FEATURE_EDITING_ASK_TERMINAL=y
CONFIG_FEATURE_EDITING_HISTORY=15
CONFIG_FEATURE_EDITING_SAVEHISTORY=n
CONFIG_FEATURE_FIND_DELETE=n
CONFIG_FEATURE_INIT_COREDUMPS=y
CONFIG_FEATURE_IPC_SYSLOG_BUFFER_SIZE=64
CONFIG_FEATURE_KILL_REMOVED=y
CONFIG_FEATURE_KMSG_SYSLOG=n
CONFIG_FEATURE_LAST_FANCY=n
CONFIG_FEATURE_LOADFONT_PSF2=n
CONFIG_FEATURE_LOADFONT_RAW=n
CONFIG_FEATURE_LOGREAD_REDUCED_LOCKING=n
CONFIG_FEATURE_LSMOD_PRETTY_2_6_OUTPUT=y
CONFIG_FEATURE_LS_COLOR_IS_DEFAULT=n
CONFIG_FEATURE_LZMA_FAST=y
CONFIG_FEATURE_MODPROBE_BLACKLIST=y
CONFIG_FEATURE_MODUTILS_ALIAS=y
CONFIG_FEATURE_MODUTILS_SYMBOLS=y
CONFIG_FEATURE_MOUNT_CIFS=n
CONFIG_FEATURE_MOUNT_HELPERS=y
CONFIG_FEATURE_MOUNT_VERBOSE=n
CONFIG_FEATURE_NAMEIF_EXTENDED=n
CONFIG_FEATURE_NETSTAT_PRG=n
CONFIG_FEATURE_NETSTAT_WIDE=n
CONFIG_FEATURE_NON_POSIX_CP=n
CONFIG_FEATURE_OSF_LABEL=y
CONFIG_FEATURE_PIDOF_OMIT=n
CONFIG_FEATURE_PIDOF_SINGLE=n
CONFIG_FEATURE_PREFER_APPLETS=y
CONFIG_FEATURE_PREFER_IPV4_ADDRESS=n
CONFIG_FEATURE_PS_TIME=n
CONFIG_FEATURE_REVERSE_SEARCH=n
CONFIG_FEATURE_RTMINMAX=n
CONFIG_FEATURE_RUN_PARTS_FANCY=n
CONFIG_FEATURE_SEAMLESS_Z=y
CONFIG_FEATURE_SGI_LABEL=y
CONFIG_FEATURE_SHOW_SCRIPT=n
CONFIG_FEATURE_SH_EXTRA_QUIET=n
CONFIG_FEATURE_SH_STANDALONE=y
CONFIG_FEATURE_SUN_LABEL=y
CONFIG_FEATURE_SWAPON_PRI=n
CONFIG_FEATURE_SYSLOGD_READ_BUFFER_SIZE=1024
CONFIG_FEATURE_TAR_AUTODETECT=n
CONFIG_FEATURE_TAR_FROM=n
CONFIG_FEATURE_TAR_OLDGNU_COMPATIBILITY=n
CONFIG_FEATURE_TAR_OLDSUN_COMPATIBILITY=n
CONFIG_FEATURE_TOPMEM=n
CONFIG_FEATURE_TOP_DECIMALS=n
CONFIG_FEATURE_TOP_SMP_CPU=n
CONFIG_FEATURE_TOP_SMP_PROCESS=n
CONFIG_FEATURE_TRACEROUTE_USE_ICMP=n
CONFIG_FEATURE_TUNCTL_UG=n
CONFIG_FEATURE_UDHCPD_BASE_IP_ON_MAC=y
CONFIG_FEATURE_UDHCPD_WRITE_LEASES_EARLY=n
CONFIG_FEATURE_VERBOSE_CP_MESSAGE=y
CONFIG_FEATURE_VI_8BIT=y
CONFIG_FEATURE_VI_MAX_LEN=1024
CONFIG_FEATURE_WC_LARGE=n
CONFIG_GZIP_FAST=2
CONFIG_INSTALL_APPLET_DONT=y
CONFIG_INSTALL_APPLET_SYMLINKS=n
CONFIG_LOGIN_SCRIPTS=n
CONFIG_LOGIN_SESSION_AS_CHILD=y
CONFIG_MODPROBE_SMALL=n
CONFIG_NOLOGIN_DEPENDENCIES=y
CONFIG_SHA1_SMALL=1
CONFIG_SHA3_SMALL=0
CONFIG_SHELL_HUSH=n
CONFIG_STACK_OPTIMIZATION_386=n
CONFIG_STATIC=y
CONFIG_SV_DEFAULT_SERVICE_DIR=""
CONFIG_UDHCPC6_DEFAULT_SCRIPT="/etc/udhcpc/default6.script"
CONFIG_UDHCPC_DEFAULT_SCRIPT="/etc/udhcpc/default.script"
CONFIG_UDHCP_DEBUG=0
CONFIG_UNICODE_COMBINING_WCHARS=y
CONFIG_UNICODE_WIDE_WCHARS=y
